{
  "name": "catalogo-pronto-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "App da equipe do Catálogo Pronto: cada loja aberta já logada no Cardapio.ai e no e-mail",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "br.com.catalogopronto.desktop",
    "productName": "Catálogo Pronto",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "catalogo-pronto-setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Catálogo Pronto"
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://painel.invalido/app-desktop/"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "qrcode": "^1.5.4"
  }
}