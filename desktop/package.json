{
  "name": "catalogo-pronto-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "App da equipe do Catálogo Pronto: cada loja aberta já logada no Cardapio.ai e no e-mail",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "br.com.catalogopronto.desktop",
    "productName": "Catálogo Pronto",
    "files": ["src/**/*", "package.json"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
