# Copie para .env e preencha. NUNCA versione o .env.
#
# Gere as duas chaves com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Domínio que aponta para a VPS (o Caddy emite o certificado para ele)
DOMINIO=painel.seudominio.com

# Assina os cookies de sessão. Se mudar, todo mundo é deslogado.
CHAVE_SESSAO=

# Cifra as senhas do Cardapio.ai no banco.
# Se mudar ou perder, as credenciais salvas ficam ilegíveis e precisam ser
# cadastradas de novo. Guarde uma cópia em lugar seguro.
CHAVE_CRIPTO=

# Chave da API da Anthropic, usada só para ler as fotos.
ANTHROPIC_API_KEY=

# Conta de administrador, criada automaticamente na primeira execução.
# Depois de criada, pode remover estas duas linhas.
ADMIN_EMAIL=voce@seudominio.com
ADMIN_SENHA=
